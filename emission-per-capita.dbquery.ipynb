   "source": [
    "SELECT county_state_name, population,\n",
    "       TRY_CAST(\n",
    "          REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) / NULLIF(\n",
    "       CAST(\n",
    "          REPLACE(population, ',', '') AS DOUBLE), 0.0) AS emissions_per_person\n",
    "FROM emissions_data\n",
    "ORDER BY emissions_per_person DESC\n",
    "LIMIT 10"
   ]
  }
 ],
